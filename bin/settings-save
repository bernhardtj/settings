#!/usr/bin/env python3
from __future__ import annotations

import argparse
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))

from settings_core import SettingsError, save_settings


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Save installed dotfile edits and enabled GNOME extensions into a setup."
    )
    parser.add_argument("setup", nargs="?", default="default")
    parser.add_argument("--home", type=Path, help="override HOME for tests or staging")
    parser.add_argument("--dry-run", action="store_true", help="show changes without writing them")
    args = parser.parse_args()

    try:
        save_settings(args.setup, home=args.home, dry_run=args.dry_run)
    except SettingsError as exc:
        print(f"settings-save: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
